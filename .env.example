# Adapt platform — environment variables

# PostgreSQL (required)
# Local: docker compose up -d postgres
DATABASE_URL="postgresql://adapt:adapt@localhost:5432/adapt?schema=public"
# EC2 production (same pattern, Postgres on localhost via Docker):
# DATABASE_URL="postgresql://adapt:CHANGE_ME@localhost:5432/adapt?schema=public"

# Session signing secret (generate with: openssl rand -hex 32)
AUTH_SECRET=""

# OpenAI — document & invoice extraction
OPENAI_API_KEY=""

# Object storage (local | s3)
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./storage/uploads"
# AWS_S3_BUCKET=""
# AWS_REGION="us-east-1"

# Stripe (Phase 5 billing)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Platform admin bootstrap (optional)
PLATFORM_ADMIN_EMAIL=""
