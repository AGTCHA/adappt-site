# Prisma database URL
# Local dev:
DATABASE_URL="file:./dev.db"
# EC2 production (persistent SQLite on disk):
# DATABASE_URL="file:./prisma/prod.db"

# Turso — only needed for Vercel/serverless; skip on EC2
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Session signing secret (generate with: openssl rand -hex 32)
AUTH_SECRET=""

# OpenAI API key — powers AI document & invoice extraction
OPENAI_API_KEY=""
